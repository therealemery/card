# 必填：PostgreSQL 连接串
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/cardlink

# 必填：项目自举接口（/api/projects）的主密钥，请换成强随机值
MASTER_KEY=change-me-to-a-long-random-string

# 可选：到期扫描间隔（分钟），默认 60
SCAN_INTERVAL_MINUTES=60

# 可选：剩余多少天内算"临期"并推送 card.expiring，默认 7
EXPIRING_DAYS=7

# 说明：测试用的连接串见 tests/conftest.py 顶部注释
# （默认 postgresql://postgres:postgres@127.0.0.1:15432/cardlink_test）
