# 必填：SQLite 数据库文件路径（目录不存在会自动创建；也接受 sqlite:/// 前缀写法）
DATABASE_URL=./data/cardlink.db

# 必填：项目自举接口（/api/projects）的主密钥，请换成强随机值
MASTER_KEY=change-me-to-a-long-random-string

# 必填：面板管理员账号密码（/admin 登录用，单一管理员）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# 可选：面板会话有效天数，默认 7
ADMIN_SESSION_DAYS=7

# 可选：到期扫描间隔（分钟），默认 60
SCAN_INTERVAL_MINUTES=60

# 可选：剩余多少天内算"临期"并推送 card.expiring，默认 7
EXPIRING_DAYS=7

# 说明：测试用独立临时文件库，不读这里的配置
